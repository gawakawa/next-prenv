DATABASE_URL="mysql://root:password@localhost:3306/app"

# No IAP in front of localhost, so nothing ever sets
# x-goog-iap-jwt-assertion here. This opts in to a dev-only stand-in
# identity — never set in terraform/env/preview, so preview stays fail-closed.
AUTH_DEV_BYPASS="1"
AUTH_SECRET="dev-secret"

# NixOS only: Prisma's CLI blocks its own engine auto-download on NixOS
# (it looks for a "linux-nixos" build that Prisma doesn't publish). Point it
# at nixpkgs' prebuilt engines instead. Not needed inside Docker (Debian).
#
# Get the path with:
#   nix build nixpkgs#prisma-engines_6 --no-link --print-out-paths
#
# PRISMA_QUERY_ENGINE_LIBRARY="<that path>/lib/libquery_engine.node"
# PRISMA_QUERY_ENGINE_BINARY="<that path>/bin/query-engine"
# PRISMA_SCHEMA_ENGINE_BINARY="<that path>/bin/schema-engine"
