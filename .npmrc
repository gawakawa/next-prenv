# Works around a Turbopack resolver bug in next@16.3.1 (fixed upstream in
# https://github.com/vercel/next.js/pull/97372, not yet in a published
# release): pnpm's nested .pnpm/node_modules layout gives the resolver two
# candidate directories for the same package, and it silently drops the
# esm/module-sync result (e.g. @swc/helpers), crashing `output: 'standalone'`
# at runtime. Hoisting collapses that to one candidate directory, which the
# PR description confirms sidesteps the bug. Drop this once a release with
# the fix ships.
node-linker=hoisted
