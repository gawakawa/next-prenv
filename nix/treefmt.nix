_: {
  perSystem = _: {
    treefmt = {
      programs = {
        nixfmt = {
          enable = true;
          includes = [ "*.nix" ];
        };
        terraform = {
          enable = true;
          includes = [
            "*.tf"
            "*.tfvars"
          ];
        };
        oxfmt = {
          enable = true;
          includes = [
            "*.ts"
            "*.tsx"
            "*.js"
            "*.jsx"
            "*.mjs"
            "*.cjs"
            "*.json"
            "*.jsonc"
            "*.json5"
            "*.md"
            "*.mdx"
            "*.yaml"
            "*.yml"
          ];
          excludes = [
            "pnpm-lock.yaml"
            # Regenerated by `next build`/`next dev` on every run; not worth
            # reformatting to the repo's single-quote convention.
            "next-env.d.ts"
          ];
        };
      };
    };
  };
}
